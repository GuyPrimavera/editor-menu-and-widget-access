#. Description of the plugin
#: editor-menu-widget-access.php
msgid "Give selected roles appearance access and simplify their admin menus and toolbar."
msgstr "Concedi l'accesso alle funzioni di Aspetto ai ruoli selezionati e semplifica il menu di amministrazione e la barra degli strumenti."

#: includes/Admin/SettingsPage.php:26 includes/Admin/SettingsPage.php:28
#: templates/admin/settings.php:8
msgid "Editor Access"
msgstr "Accesso degli editor"

#: includes/Admin/SettingsPage.php:33
msgid "Settings"
msgstr "Impostazioni"

#: includes/Admin/SettingsPage.php:60
msgid "You have unsaved changes."
msgstr "Hai modifiche non salvate."

#: includes/Admin/SettingsPage.php:61
msgid "Reset this role’s settings on the current tab? Selected roles and other tabs stay the same. A backup will be saved first."
msgstr "Ripristinare le impostazioni di questo ruolo nella scheda corrente? I ruoli selezionati e le altre schede resteranno invariati. Verrà prima salvata una copia di sicurezza."

#: includes/Admin/SettingsPage.php:62
msgid "Restore this saved configuration? Your current settings will be backed up first."
msgstr "Ripristinare questa configurazione salvata? Verrà prima salvata una copia delle impostazioni correnti."

#: includes/Admin/SettingsPage.php:63
msgid "Reset Appearance permissions for this role? Built-in WordPress roles will lose any stored edit_theme_options grant. A backup is saved first."
msgstr "Ripristinare i permessi di Aspetto per questo ruolo? I ruoli predefiniti di WordPress perderanno l'eventuale permesso edit_theme_options salvato. Verrà prima salvata una copia di sicurezza."

#: includes/Admin/SettingsPage.php:64
msgid "Copy the reviewed profile to this role? Its existing profile will be backed up first."
msgstr "Copiare il profilo esaminato in questo ruolo? Verrà prima salvata una copia del profilo esistente."

#: includes/Admin/SettingsPage.php:65
msgid "Copied."
msgstr "Copiato."

#: includes/Admin/SettingsPage.php:66
msgid "Expand"
msgstr "Espandi"

#: includes/Admin/SettingsPage.php:67 templates/admin/visibility.php:102
msgid "Collapse"
msgstr "Comprimi"

#: includes/Admin/SettingsActions.php:13 includes/Admin/SettingsPage.php:76
msgid "You do not have permission to manage Editor Access."
msgstr "Non hai i permessi per gestire Accesso degli editor."

#: includes/Admin/SettingsForm.php:37
msgid "The form is incomplete or invalid. Reload the page; settings were not changed."
msgstr "Il modulo è incompleto o non valido. Ricarica la pagina; le impostazioni non sono state modificate."

#: includes/Admin/SettingsForm.php:41
msgid "Invalid form details."
msgstr "I dati del modulo non sono validi."

#: includes/Admin/SettingsForm.php:51
msgid "Select an existing role profile before saving."
msgstr "Seleziona un profilo di ruolo esistente prima di salvare."

#: includes/Admin/SettingsForm.php:59
msgid "Invalid role selection."
msgstr "La selezione dei ruoli non è valida."

#: includes/Admin/SettingsForm.php:83 includes/Admin/SettingsForm.php:106
msgid "Invalid appearance selection."
msgstr "La selezione delle voci di Aspetto non è valida."

#: includes/Admin/SettingsForm.php:92
msgid "Invalid visibility selection."
msgstr "La selezione delle voci da mostrare o nascondere non è valida."

#: includes/Admin/SettingsForm.php:130
msgid "Invalid toolbar scope."
msgstr "L'ambito della barra degli strumenti non è valido."

#: includes/Admin/SettingsForm.php:136
msgid "Invalid settings action."
msgstr "L'azione richiesta per le impostazioni non è valida."

#: includes/Admin/SettingsActions.php:24
msgid "The form was truncated or incomplete. Reload before saving. Existing settings were preserved."
msgstr "Il modulo è stato troncato o è incompleto. Ricarica la pagina prima di salvare. Le impostazioni esistenti sono state conservate."

#: includes/Admin/SettingsActions.php:31
msgid "The selected backup is unavailable."
msgstr "La copia di sicurezza selezionata non è disponibile."

#: includes/Admin/SettingsActions.php:49
msgid "Settings saved. Previous settings are available in Help."
msgstr "Impostazioni salvate. Le impostazioni precedenti sono disponibili nella scheda Aiuto."

#: includes/Admin/SettingsActions.php:60
msgid "You do not have permission to edit role capabilities."
msgstr "Non hai i permessi per modificare le capacità dei ruoli."

#: includes/Admin/SettingsActions.php:71
msgid "The permission-reset form was incomplete. Nothing was changed."
msgstr "Il modulo per il ripristino dei permessi è incompleto. Non è stato modificato nulla."

#: includes/Admin/SettingsActions.php:72
msgid "This role’s Appearance permission was reset to the WordPress default. This plugin’s grant and Customizer restriction are off for the role."
msgstr "Il permesso di Aspetto di questo ruolo è stato riportato al valore predefinito di WordPress. La concessione del plugin e la restrizione dell'Utilità di personalizzazione sono disattivate per questo ruolo."

#: includes/Admin/SettingsActions.php:72
msgid "This plugin’s grant and Customizer restriction are off for the role. Stored permissions owned by WooCommerce or other plugins were preserved."
msgstr "La concessione del plugin e la restrizione dell'Utilità di personalizzazione sono disattivate per questo ruolo. I permessi salvati e gestiti da WooCommerce o da altri plugin sono stati conservati."

#: includes/Admin/SettingsActions.php:100
msgid "The profile-copy form was incomplete. Nothing was changed."
msgstr "Il modulo per la copia del profilo è incompleto. Non è stato modificato nulla."

#: includes/Admin/SettingsActions.php:105
msgid "Profile copied. The target role’s previous settings are available in Help & Backups."
msgstr "Profilo copiato. Le impostazioni precedenti del ruolo di destinazione sono disponibili in Aiuto e copie di sicurezza."

#: includes/Admin/SettingsActions.php:126
msgid "You do not have permission to view role capability backups."
msgstr "Non hai i permessi per visualizzare le copie di sicurezza delle capacità dei ruoli."

#: includes/Admin/SettingsActions.php:131
msgid "Role capability backup data is invalid."
msgstr "I dati delle copie di sicurezza delle capacità dei ruoli non sono validi."

#: includes/Admin/SettingsPage.php:161
msgid "Entire Appearance menu"
msgstr "Intero menu Aspetto"

#: includes/Admin/SettingsPage.php:162
msgid "Themes"
msgstr "Temi"

#: includes/Admin/SettingsPage.php:163
msgid "Customize, Header and Background"
msgstr "Personalizza, intestazione e sfondo"

#: includes/Admin/SettingsPage.php:164
msgid "Widgets"
msgstr "Widget"

#: includes/Admin/SettingsPage.php:165
msgid "Menus / Navigation"
msgstr "Menu / Navigazione"

#: includes/Admin/SettingsPage.php:166
msgid "Site Editor / Design"
msgstr "Editor del sito / Design"

#: includes/Admin/SettingsPage.php:169
msgid "Patterns"
msgstr "Pattern"

#: includes/Admin/SettingsPage.php:171
msgid "Font Library"
msgstr "Libreria dei font"

#: includes/ProfileCopy.php:10
msgid "Choose two different available roles."
msgstr "Scegli due ruoli disponibili e diversi."

#: includes/ProfileCopy.php:15
msgid "A role is unavailable or has administrator permissions."
msgstr "Un ruolo non è disponibile oppure ha permessi di amministratore."

#: includes/ProfileCopy.php:19
msgid "Settings changed since this review opened. Reload and review the copy again; nothing was changed."
msgstr "Le impostazioni sono cambiate da quando hai aperto questa anteprima. Ricarica la pagina e controlla di nuovo la copia; non è stato modificato nulla."

#: includes/RolePermissions.php:27
msgid "Role permission backup storage is invalid. No permissions were changed."
msgstr "L'archivio delle copie di sicurezza dei permessi dei ruoli non è valido. Nessun permesso è stato modificato."

#: includes/RolePermissions.php:42
msgid "The role permission backup could not be saved. No permissions were changed."
msgstr "Impossibile salvare la copia di sicurezza dei permessi del ruolo. Nessun permesso è stato modificato."

#: includes/RolePermissions.php:163
msgid "Select an available non-administrator role."
msgstr "Seleziona un ruolo disponibile che non sia amministratore."

#: includes/RolePermissions.php:167
msgid "This role is unavailable or has administrator permissions."
msgstr "Questo ruolo non è disponibile oppure ha permessi di amministratore."

#: includes/RolePermissions.php:171
msgid "Settings or role permissions changed since this page opened. Reload before resetting; nothing was changed."
msgstr "Le impostazioni o i permessi del ruolo sono cambiati da quando hai aperto la pagina. Ricaricala prima del ripristino; non è stato modificato nulla."

#: includes/RolePermissions.php:199
msgid "The plugin grant was disabled, but the stored role permission could not be removed. A backup is available; retry after checking role-management plugins."
msgstr "La concessione del plugin è stata disattivata, ma non è stato possibile rimuovere il permesso salvato del ruolo. È disponibile una copia di sicurezza; verifica i plugin che gestiscono i ruoli e riprova."

#: includes/Settings.php:139
msgid "Settings are malformed or use an unsupported version. Existing data has been preserved."
msgstr "Le impostazioni non sono valide oppure usano una versione non supportata. I dati esistenti sono stati conservati."

#: includes/Settings.php:142
msgid "Settings exceed the supported size."
msgstr "Le impostazioni superano la dimensione supportata."

#: includes/Settings.php:146
msgid "Every selected role must have a valid profile."
msgstr "Ogni ruolo selezionato deve avere un profilo valido."

#: includes/Settings.php:152 includes/Settings.php:155
msgid "Invalid role profile."
msgstr "Il profilo del ruolo non è valido."

#: includes/Settings.php:159
msgid "Invalid appearance rule."
msgstr "La regola per Aspetto non è valida."

#: includes/Settings.php:163
msgid "Too many visibility rules."
msgstr "Sono presenti troppe regole di visibilità."

#: includes/Settings.php:167
msgid "Invalid menu rule."
msgstr "La regola del menu non è valida."

#: includes/Settings.php:172
msgid "Invalid toolbar rule."
msgstr "La regola della barra degli strumenti non è valida."

#: includes/Settings.php:213
msgid "The settings backup is unreadable. No settings were changed."
msgstr "La copia di sicurezza delle impostazioni non è leggibile. Nessuna impostazione è stata modificata."

#: includes/Settings.php:222
msgid "Could not save a backup. No settings were changed."
msgstr "Impossibile salvare una copia di sicurezza. Nessuna impostazione è stata modificata."

#: includes/Settings.php:236
msgid "Settings changed since this page was opened, or cannot be safely edited. Reload before trying again. No settings were changed."
msgstr "Le impostazioni sono cambiate da quando hai aperto la pagina, oppure non possono essere modificate in sicurezza. Ricarica la pagina e riprova. Nessuna impostazione è stata modificata."

#: includes/Settings.php:251
msgid "Another save won the race or the database rejected this save. Reload the settings page. Your previous settings are preserved."
msgstr "Un altro salvataggio è stato completato prima di questo, oppure il database lo ha rifiutato. Ricarica la pagina delle impostazioni. Le impostazioni precedenti sono state conservate."

#: includes/Settings.php:261
msgid "Import must be JSON smaller than 1 MB."
msgstr "Il file JSON da importare deve essere più piccolo di 1 MB."

#: includes/Settings.php:265
msgid "This is not a supported Editor Access settings export."
msgstr "Questo file non è un'esportazione delle impostazioni di Accesso degli editor supportata."

#: templates/admin/access-preview.php:7 templates/admin/profile-copy.php:37
#: templates/admin/settings.php:19 templates/admin/settings.php:21
msgid "Yes"
msgstr "Sì"

#: templates/admin/access-preview.php:8 templates/admin/profile-copy.php:38
#: templates/admin/settings.php:19 templates/admin/settings.php:21
msgid "No"
msgstr "No"

#: templates/admin/access-preview.php:11
msgid "Access preview"
msgstr "Anteprima dell'accesso"

#: templates/admin/access-preview.php:12
msgid "This is a read-only snapshot of saved settings and the menus registered on this administrator screen. Other plugins may add role-specific items or make additional checks on their own pages."
msgstr "Questa è un'anteprima di sola lettura delle impostazioni salvate e dei menu registrati in questa schermata di amministrazione. Altri plugin possono aggiungere voci specifiche per un ruolo o effettuare ulteriori controlli nelle proprie pagine."

#: templates/admin/access-preview.php:15 templates/admin/settings.php:18
msgid "Stored Appearance permission"
msgstr "Permesso di Aspetto salvato"

#: templates/admin/access-preview.php:16 templates/admin/settings.php:20
msgid "Active plugin Appearance grant"
msgstr "Accesso ad Aspetto concesso dal plugin attivo"

#: templates/admin/access-preview.php:18
msgid "Sample user"
msgstr "Utente di esempio"

#: templates/admin/access-preview.php:19
msgid "Effective Appearance permission for sample user"
msgstr "Permesso effettivo di Aspetto per l'utente di esempio"

#: templates/admin/access-preview.php:24
msgid "The sample is one existing user with this role. Their other roles and user-specific permissions also apply. Menu results below are estimates based on the items registered for this administrator."
msgstr "L'esempio usa un utente esistente con questo ruolo. Si applicano anche gli altri suoi ruoli e i permessi specifici dell'utente. I risultati dei menu qui sotto sono stime basate sulle voci registrate per questo amministratore."

#: templates/admin/access-preview.php:26
msgid "Review top-level menu estimates"
msgstr "Esamina le stime dei menu principali"

#: templates/admin/access-preview.php:28
msgid "Menu"
msgstr "Menu"

#: templates/admin/access-preview.php:28
msgid "Estimated status"
msgstr "Stato stimato"

#: templates/admin/access-preview.php:30
msgid "Hidden by this plugin"
msgstr "Nascosto da questo plugin"

#: templates/admin/access-preview.php:30
msgid "User lacks menu capability"
msgstr "L'utente non possiede la capacità richiesta dal menu"

#: templates/admin/access-preview.php:30
msgid "Potentially visible"
msgstr "Potenzialmente visibile"

#: templates/admin/access-preview.php:30
msgid "Capability unknown"
msgstr "Capacità sconosciuta"

#: templates/admin/access-preview.php:36
msgid "No existing user has this role, so effective user permissions cannot be checked yet."
msgstr "Nessun utente esistente ha questo ruolo, quindi non è ancora possibile verificare i permessi effettivi di un utente."

#: templates/admin/help.php:11
msgid "Settings safety"
msgstr "Sicurezza delle impostazioni"

#: templates/admin/help.php:15
msgid "Keep a database backup before downgrading. Legacy options are preserved exactly as they were at upgrade; changes made in version 4 are not written back into the older format."
msgstr "Esegui una copia di sicurezza del database prima di tornare a una versione precedente. Le opzioni della vecchia versione sono conservate esattamente come erano prima dell'aggiornamento; le modifiche effettuate nella versione 4 non vengono riportate nel vecchio formato."

#: templates/admin/help.php:16
msgid "Export settings"
msgstr "Esporta impostazioni"

#: templates/admin/help.php:17
msgid "Import settings"
msgstr "Importa impostazioni"

#: templates/admin/help.php:18
msgid "Paste a settings export below. Imported profiles replace matching profiles; other profiles and selected roles are retained. A backup is saved first."
msgstr "Incolla qui sotto un'esportazione delle impostazioni. I profili importati sostituiscono quelli corrispondenti; gli altri profili e i ruoli selezionati vengono conservati. Verrà prima salvata una copia di sicurezza."

#: templates/admin/help.php:23
msgid "Settings JSON"
msgstr "JSON delle impostazioni"

#: templates/admin/help.php:25
msgid "Import and merge profiles"
msgstr "Importa e unisci i profili"

#: templates/admin/help.php:29
msgid "Restore a settings backup"
msgstr "Ripristina una copia di sicurezza delle impostazioni"

#: templates/admin/help.php:34
msgid "Saved configuration"
msgstr "Configurazione salvata"

#: templates/admin/help.php:44
msgid "Restore backup"
msgstr "Ripristina copia di sicurezza"

#: templates/admin/help.php:49
msgid "Role permission reset backups"
msgstr "Copie di sicurezza prima del ripristino dei permessi dei ruoli"

#: templates/admin/help.php:50
msgid "The ten most recent role-capability snapshots are kept separately from settings backups. Download them before restoring a capability with a role-management tool; restoring an entire snapshot automatically could overwrite permissions changed by another plugin."
msgstr "Le dieci istantanee più recenti delle capacità dei ruoli sono conservate separatamente dalle copie delle impostazioni. Scaricale prima di ripristinare una capacità con uno strumento di gestione dei ruoli: il ripristino automatico di un'intera istantanea potrebbe sovrascrivere i permessi modificati successivamente da un altro plugin."

#: templates/admin/help.php:58
msgid "Download role permission backups"
msgstr "Scarica le copie di sicurezza dei permessi dei ruoli"

#: templates/admin/help.php:60
msgid "Compatibility diagnostics"
msgstr "Diagnostica di compatibilità"

#: templates/admin/help.php:61
msgid "This summary omits account details, site URLs and secrets. Menu and toolbar rules use stable IDs; plugins still enforce their own permissions."
msgstr "Questo riepilogo non contiene dati degli account, URL del sito o informazioni riservate. Le regole dei menu e della barra degli strumenti usano identificatori stabili; i plugin continuano a gestire autonomamente i propri permessi."

#: templates/admin/help.php:62
msgid "Diagnostic summary"
msgstr "Riepilogo diagnostico"

#: templates/admin/help.php:64
msgid "Copy diagnostics"
msgstr "Copia diagnostica"

#: templates/admin/help.php:65
msgid "Support forum"
msgstr "Forum di supporto"

#: templates/admin/help.php:65
msgid "Documentation and source"
msgstr "Documentazione e codice sorgente"

#: templates/admin/profile-copy.php:18
msgid "Copy this role’s profile"
msgstr "Copia il profilo di questo ruolo"

#: templates/admin/profile-copy.php:19
msgid "Copy the saved Appearance, admin menu and toolbar settings to another role. The destination role’s profile is replaced; its selected or paused status stays the same. Stored WordPress role capabilities are unchanged."
msgstr "Copia le impostazioni salvate di Aspetto, del menu di amministrazione e della barra degli strumenti in un altro ruolo. Il profilo del ruolo di destinazione viene sostituito; il suo stato di selezione o sospensione resta invariato. Le capacità dei ruoli salvate in WordPress non vengono modificate."

#: templates/admin/profile-copy.php:24
msgid "Destination role"
msgstr "Ruolo di destinazione"

#: templates/admin/profile-copy.php:26
msgid "Choose a role"
msgstr "Scegli un ruolo"

#: templates/admin/profile-copy.php:31
msgid "Review copy"
msgstr "Esamina la copia"

#: templates/admin/profile-copy.php:53
msgid "Setting"
msgstr "Impostazione"

#: templates/admin/profile-copy.php:53
msgid "Current destination"
msgstr "Destinazione attuale"

#: templates/admin/profile-copy.php:53
msgid "After copy"
msgstr "Dopo la copia"

#: templates/admin/profile-copy.php:55
msgid "Appearance grant"
msgstr "Concessione per Aspetto"

#: templates/admin/profile-copy.php:56
msgid "Customizer restriction"
msgstr "Restrizione dell'Utilità di personalizzazione"

#: templates/admin/profile-copy.php:57
msgid "Hidden Appearance areas"
msgstr "Aree di Aspetto nascoste"

#: templates/admin/profile-copy.php:58
msgid "Hidden admin menu rules"
msgstr "Regole del menu di amministrazione nascoste"

#: templates/admin/profile-copy.php:59
msgid "Hidden toolbar rules"
msgstr "Regole della barra degli strumenti nascoste"

#: templates/admin/profile-copy.php:62
msgid "Review both profiles before copying. The settings backup can restore the destination profile if needed."
msgstr "Controlla entrambi i profili prima di copiarli. Se necessario, la copia di sicurezza delle impostazioni può ripristinare il profilo di destinazione."

#: templates/admin/profile-copy.php:69
msgid "Copy reviewed profile"
msgstr "Copia il profilo esaminato"

#: templates/admin/role-reset.php:10
msgid "Reset Appearance permissions"
msgstr "Ripristina i permessi di Aspetto"

#: templates/admin/role-reset.php:12
msgid "For this built-in WordPress role, reset removes a stored edit_theme_options grant and turns off this plugin’s appearance grant and Customizer restriction. Other capabilities, menu rules and roles are unchanged. If another plugin added the grant, it may add it again. A copy of the role’s capabilities is saved before removal."
msgstr "Per questo ruolo predefinito di WordPress, il ripristino rimuove un'eventuale concessione salvata di edit_theme_options e disattiva la concessione per Aspetto e la restrizione dell'Utilità di personalizzazione del plugin. Le altre capacità, le regole dei menu e gli altri ruoli restano invariati. Se un altro plugin aveva aggiunto la concessione, potrebbe aggiungerla di nuovo. Prima della rimozione viene salvata una copia delle capacità del ruolo."

#: templates/admin/role-reset.php:14
msgid "WordPress has no default permissions for this plugin-defined role. Reset turns off this plugin’s appearance grant and Customizer restriction, while preserving capabilities supplied by WooCommerce or other plugins. WooCommerce grants Shop Manager Appearance access by default."
msgstr "WordPress non definisce permessi predefiniti per questo ruolo creato da un plugin. Il ripristino disattiva la concessione per Aspetto e la restrizione dell'Utilità di personalizzazione di questo plugin, conservando le capacità fornite da WooCommerce o da altri plugin. WooCommerce concede ai Gestori del negozio l'accesso ad Aspetto per impostazione predefinita."

#: templates/admin/role-reset.php:23
msgid "Reset permissions to WordPress defaults"
msgstr "Ripristina i permessi predefiniti di WordPress"

#: templates/admin/role-reset.php:23
msgid "Reset this plugin’s permissions"
msgstr "Ripristina i permessi di questo plugin"

#: templates/admin/role-reset.php:27
msgid "This role is unavailable or cannot be reset with your current permissions."
msgstr "Questo ruolo non è disponibile oppure non puoi ripristinarlo con i tuoi permessi attuali."

#: templates/admin/roles.php:6
msgid "Roles using Editor Access"
msgstr "Ruoli che usano Accesso degli editor"

#: templates/admin/roles.php:7
msgid "Tick the roles that should use these settings, then save. Use Edit access beside a role to configure its permissions. Unticking a role pauses its profile without deleting it. Administrators, super admins and users with Manage Options remain unaffected."
msgstr "Seleziona i ruoli a cui applicare queste impostazioni, poi salva. Usa Modifica accesso accanto a un ruolo per configurarne i permessi. Deselezionare un ruolo sospende il suo profilo senza eliminarlo. Amministratori, super amministratori e utenti con la capacità Manage Options non sono interessati."

#: templates/admin/roles.php:13
msgid "Editing access"
msgstr "Accesso in modifica"

#: templates/admin/roles.php:13
msgid "Edit access"
msgstr "Modifica accesso"

#: templates/admin/roles.php:15
msgid "Role unavailable; saved profile retained"
msgstr "Ruolo non disponibile; il profilo salvato viene conservato"

#. translators: %s: name of the WordPress role being configured.
#: templates/admin/roles.php:22
#, php-format, python-format
msgid "Appearance permissions for %s"
msgstr "Permessi di Aspetto per %s"

#: templates/admin/roles.php:26
msgid "This profile is inactive until you tick the role above and save."
msgstr "Questo profilo resta inattivo finché non selezioni il ruolo qui sopra e salvi."

#: templates/admin/roles.php:28
msgid "Add appearance access while this plugin is active"
msgstr "Concedi l'accesso ad Aspetto finché questo plugin è attivo"

#: templates/admin/roles.php:29
msgid "WordPress uses the same capability for widgets, menus, Site Editor and some theme options. Existing permissions and explicit denials from WordPress or other plugins are respected. Unchecking this does not revoke permissions granted elsewhere or retained from an older version."
msgstr "WordPress usa la stessa capacità per widget, menu, Editor del sito e alcune opzioni del tema. I permessi esistenti e i dinieghi espliciti di WordPress o di altri plugin vengono rispettati. Deselezionare questa opzione non revoca i permessi concessi altrove o conservati da una versione precedente."

#: templates/admin/roles.php:33
msgid "WooCommerce grants Shop Manager this Appearance permission by default. It remains after this plugin is deactivated."
msgstr "WooCommerce concede per impostazione predefinita questo permesso di Aspetto ai Gestori del negozio. Il permesso rimane anche dopo la disattivazione del plugin."

#: templates/admin/roles.php:35
msgid "This built-in role has a stored Appearance permission beyond its WordPress default. Turning off the plugin grant above will not remove it; use the reset action below if you want the default."
msgstr "Questo ruolo predefinito ha un permesso di Aspetto salvato che supera il valore predefinito di WordPress. Disattivare la concessione del plugin qui sopra non lo rimuove; usa il ripristino qui sotto se vuoi tornare al valore predefinito."

#: templates/admin/roles.php:37
msgid "This plugin-defined role has a stored Appearance permission. Its owning plugin controls that permission, so the reset below leaves it intact."
msgstr "Questo ruolo creato da un plugin ha un permesso di Aspetto salvato. Il plugin che gestisce il ruolo controlla quel permesso, quindi il ripristino qui sotto lo conserva."

#: templates/admin/roles.php:40
msgid "Deny direct access to the WordPress Customizer"
msgstr "Nega l'accesso diretto all'Utilità di personalizzazione di WordPress"

#: templates/admin/roles.php:41
msgid "This optional permission restriction uses WordPress capability checks and also prevents Customizer saves. It does not restrict widgets, Site Editor or third-party settings pages."
msgstr "Questa restrizione facoltativa usa i controlli delle capacità di WordPress e impedisce anche il salvataggio nell'Utilità di personalizzazione. Non limita widget, Editor del sito o pagine di impostazioni di terze parti."

#: templates/admin/roles.php:42
msgid "To hide Appearance links, use the Admin Menu tab for this role."
msgstr "Per nascondere i collegamenti di Aspetto, usa la scheda Menu di amministrazione per questo ruolo."

#: templates/admin/roles.php:43
msgid "For users with multiple selected roles, hiding or a Customizer restriction in any matching profile takes precedence. Any matching profile may add appearance access."
msgstr "Per gli utenti con più ruoli selezionati, prevale qualsiasi regola che nasconde una voce o limita l'Utilità di personalizzazione. Qualsiasi profilo corrispondente può concedere l'accesso ad Aspetto."

#: templates/admin/settings.php:9
msgid "Give selected roles appearance access and simplify their WordPress workspace."
msgstr "Concedi ai ruoli selezionati l'accesso ad Aspetto e semplifica la loro area di lavoro in WordPress."

#: templates/admin/settings.php:17
msgid "Reset verification:"
msgstr "Verifica del ripristino:"

